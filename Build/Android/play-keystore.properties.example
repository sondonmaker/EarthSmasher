# Google Play 업로드용 서명 키 설정
# 1) 이 파일을 play-keystore.properties 로 복사
# 2) 아래 값을 채운 뒤 build-play-aab.ps1 실행
#
# play-keystore.properties 는 Git에 올리지 마세요 (.gitignore 처리됨)

keystorePath=C:/Users/YOU/keys/earthsmasher-upload.keystore
keystorePass=YOUR_STORE_PASSWORD
keyAlias=upload
keyAliasPass=YOUR_KEY_PASSWORD
